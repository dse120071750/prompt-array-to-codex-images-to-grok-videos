{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prompt_batch_ready.input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["request"],
  "properties": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompts"],
      "properties": {
        "prompts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "pattern": "\\S"}}
      }
    }
  }
}
