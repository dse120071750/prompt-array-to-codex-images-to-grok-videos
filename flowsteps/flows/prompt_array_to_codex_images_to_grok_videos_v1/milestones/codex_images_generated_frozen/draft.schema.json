{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codex_images_generated_frozen.draft.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["count", "images"],
  "properties": {
    "count": {"type": "integer", "minimum": 1},
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "index", "source_prompt", "image_prompt", "generated_file"],
        "properties": {
          "id": {"type": "string", "pattern": "^prompt-[0-9]{3}$"},
          "index": {"type": "integer", "minimum": 0},
          "source_prompt": {"type": "string", "minLength": 1},
          "image_prompt": {"type": "string", "minLength": 1},
          "generated_file": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
