{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["videos", "receipt"],
  "properties": {
    "videos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "path", "index", "prompt"]
      }
    },
    "receipt": {
      "type": "object",
      "required": ["schema", "transport", "session_id", "grok_version", "count", "format", "attempt_dir", "clips"]
    }
  }
}
