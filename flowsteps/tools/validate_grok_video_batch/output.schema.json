{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["videos", "receipt", "validation"],
  "properties": {
    "videos": {"type": "array", "minItems": 1},
    "receipt": {"type": "object"},
    "validation": {
      "type": "object",
      "required": ["ok", "code", "count"],
      "properties": {
        "ok": {"const": true},
        "code": {"const": "technical_pass"},
        "count": {"type": "integer", "minimum": 1}
      }
    }
  }
}
